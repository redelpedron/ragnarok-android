+//go:build android
+
+package gogpu
+
+import (
+	"unsafe"
+
+	"github.com/gogpu/wgpu"
+)
+
+// SurfaceConfigAndroid extends the default config with an ANativeWindow handle.
+type SurfaceConfigAndroid struct {
+	SurfaceConfig
+	NativeWindow uintptr // *ANativeWindow from android/native_window.h
+}
+
+func (cfg *SurfaceConfigAndroid) Apply() {
+	// Create a Vulkan surface from the ANativeWindow.
+	// This requires the wgpu Android backend which has preview support
+	// for ANativeWindow surfaces.
+	window := unsafe.Pointer(cfg.NativeWindow)
+
+	// The exact API depends on the gogpu/wgpu version.
+	// For the preview Android backend, it looks like:
+	surfaceDesc := wgpu.SurfaceDescriptor{
+		NextInChain: &wgpu.SurfaceDescriptorFromAndroidNativeWindow{
+			Chain: wgpu.ChainedStruct{
+				SType: wgpu.SType_SurfaceDescriptorFromAndroidNativeWindow,
+			},
+			Window: window,
+		},
+	}
+
+	// Store on App for later surface configuration
+	// (Actual integration depends on gogpu's internal surface factory)
+}
+
+// WithNativeWindow sets the ANativeWindow for Android builds.
+func (c *AppConfig) WithNativeWindow(nativeWindow uintptr) *AppConfig {
+	c.surfaceFactory = func(inst *wgpu.Instance) *wgpu.Surface {
+		// Use the Android-specific surface creation path
+		return inst.CreateSurfaceAndroidNativeWindow(nativeWindow)
+	}
+	return c
+}
